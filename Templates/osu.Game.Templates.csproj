<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Torii.Game.Templates</PackageId>
    <Title>Torii templates</Title>
    <Authors>Torii contributors</Authors>
    <PackageLicenseUrl>https://github.com/ShikkesoraSIM/torii/blob/master/LICENCE</PackageLicenseUrl>
    <PackageProjectUrl>https://github.com/ShikkesoraSIM/torii/blob/master/Templates</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ShikkesoraSIM/torii</RepositoryUrl>
    <PackageReleaseNotes>Automated release.</PackageReleaseNotes>
    <copyright>Copyright (c) 2025 Torii contributors</copyright>
    <Description>Templates to use when creating a ruleset for consumption in Torii.</Description>
    <PackageTags>dotnet-new;templates;torii</PackageTags>
    <TargetFramework>netstandard2.1</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Rulesets\**\*" Exclude="Rulesets\**\bin\**;Rulesets\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>
</Project>
